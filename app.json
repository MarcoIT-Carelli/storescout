{
  "expo": {
    "name": "StoreScout",
    "slug": "storescout",
    "platforms": [
      "android"
    ],
    "version": "1.1.0",
    "scheme": "storescout",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "it.carellidistribuzione.storescout",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#FFFFFF",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0F0F0E"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "StoreScout usa la fotocamera per allegare le foto alle attività rilevate durante l’ispezione."
        }
      ]
    ],
    "backgroundColor": "#FFFFFF",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec71b8a6-43b5-45f0-af9a-80bc2c035ff1"
      }
    },
    "owner": "carelli-distribuzione",
    "updates": {
      "url": "https://u.expo.dev/ec71b8a6-43b5-45f0-af9a-80bc2c035ff1",
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
